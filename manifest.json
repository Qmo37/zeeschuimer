{
  "description": "Collect data while browsing social media platforms and upload it for analysis later",
  "manifest_version": 2,
  "name": "Zeeschuimer FIMI Bridge",
  "version": "1.14.2.3",
  "homepage_url": "https://github.com/Qmo37/zeeschuimer",

  "browser_specific_settings": {
    "gecko": {
      "id": "zeeschuimer-fimi@fimi-collect.local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "icons": {
    "48": "images/zeeschuimer-48.png",
    "96": "images/zeeschuimer-96.png"
  },

  "browser_action": {
    "default_icon": "images/zeeschuimer-64.png",
    "default_title": "Zeeschuimer Status"
  },

  "permissions": [
    "webRequest", "webRequestBlocking", "webNavigation", "<all_urls>", "storage", "downloads", "activeTab", "tabs",
    "unlimitedStorage"
  ],

  "incognito": "not_allowed",

  "background": {
    "scripts": [
      "inc/dexie.js",
      "inc/he.js",
      "js/lib.js",
      "js/fimi-integration.js",
      "js/zs-background.js",
      "modules/_loader.js"
    ]
  }
}
